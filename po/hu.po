msgid "terminal;prompt;ptyxis;shell;command;commandline;cmd;cli;"
msgstr "terminál;bekérés;ptyxis;parancsértelmező;parancs;parancssor;cmd;cli;"

#: data/org.gnome.Ptyxis.desktop.in.in:20
#: src/org.gnome.Ptyxis.gschema.xml.in:357 src/ptyxis-preferences-window.ui:680
msgid "New Window"
msgstr "Új ablak"

#: data/org.gnome.Ptyxis.desktop.in.in:24
#: src/org.gnome.Ptyxis.gschema.xml.in:351 src/ptyxis-preferences-window.ui:674
msgid "New Tab"
msgstr "Új lap"

#: data/org.gnome.Ptyxis.desktop.in.in:28
#: src/org.gnome.Ptyxis.gschema.xml.in:369 src/ptyxis-preferences-window.ui:849
msgid "Preferences"
msgstr "Beállítások"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:6 src/ptyxis-util.c:310
msgid "Ptyxis"
msgstr "Ptyxis"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:7
msgid "Container-oriented terminal"
msgstr "Konténerorientált terminál"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:9
msgid ""
"Ptyxis is a terminal for GNOME that focuses on ease-of-use in a world of "
"containers."
msgstr ""
"A Ptyxis egy terminál GNOME-hoz, amely a könnyű használhatóságra összpontosít "
"a konténerek világában."

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:13
msgid "Features:"
msgstr "Funkciók:"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:15
msgid ""
"Remembers current container when opening a new tab with support for podman, "
"toolbox, distrobox, and more"
msgstr ""
"Megjegyzi a jelenlegi konténert új lap megnyitásakor podman, toolbox, "
"distrobox és egyebek támogatásával"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:16
msgid "Configurable keyboard shortcuts"
msgstr "Beállítható gyorsbillentyűk"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:17
msgid "Modern interface which integrates the palette with the window styling"
msgstr "Modern felület, amely integrálja a palettát az ablak stílusával"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:18
msgid "User-installable color palettes"
msgstr "Felhasználó által telepíthető színpaletták"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:19
msgid "Support for preferences profiles with container integration"
msgstr "Beállítási profilok támogatása konténerintegrációval"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:20
msgid "Integrated color palettes with light and dark support"
msgstr "Beépített színpaletták világos és sötét mód támogatással"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:21
msgid "Tabbed interface with tab overviews"
msgstr "Lapozható felület lapáttekintésekkel"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:22
msgid "Efficient foreground process tracking denoting sudo and SSH"
msgstr "Hatékony előtéri folyamatkövetés sudo és SSH megjelöléssel"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:23
msgid "Support for transparent terminal backgrounds"
msgstr "Átlátszó terminálhátterek támogatása"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:24
msgid "Separate process mode for terminal-based applications"
msgstr "Különálló folyamatmód terminálalapú alkalmazásokhoz"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:25
msgid "Support for pinned tabs and saved sessions"
msgstr "Kitűzött lapok és mentett munkamenetek támogatása"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:26
msgid "Terminal tabs are run within separate cgroups"
msgstr "A terminállapok különálló cgroupokban futnak"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:27
msgid "Terminal inspector to help when writing terminal-based applications"
msgstr "Terminálvizsgáló, hogy segítsen terminálalapú alkalmazások írásakor"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:78
msgid "A column and row size indicator is displayed when resizing the window"
msgstr "Oszlop- és sorméretjelző jelenik meg az ablak átméretezésekor"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:83
msgid "Containers are automatically discovered and displayed"
msgstr "A konténerek automatikus felfedezésre és megjelenítésre kerülnek"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:88
msgid "Many behaviors of the terminal may be tweaked to user preference"
msgstr ""
"A terminál számos viselkedése a felhasználói beállítások szerint finomhangolha"
"tó"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:93
msgid "You may rename a tab by providing a prefix to the title"
msgstr "Átnevezhet egy lapot a címhez való előtag megadásával"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:98
msgid "Palettes provide an integrated dark mode"
msgstr "A paletták integrált sötét módot biztosítanak"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:103
msgid "You can see an overview of your tabs at any time"
msgstr "Bármikor megnézheti a lapjai áttekintését"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:108
msgid "Many shortcuts may be remapped to user preference"
msgstr "Számos gyorsbillentyű átállítható a felhasználói beállítások szerint"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:113
msgid "Built-in color palettes provide both dark and light mode variants"
msgstr ""
"A beépített színpaletták sötét és világos módú változatokat is biztosítanak"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:118
msgid ""
"Profiles allow for overriding a number of features such as default container"
msgstr ""
"A profilok lehetővé teszik számos funkció felülbírálását, például az alapértel"
"mezett konténert"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:123
msgid "The terminal will remind you when you're root on the local system"
msgstr "A terminál emlékeztetni fogja, ha Ön rendszergazda a helyi rendszeren"

#: data/org.gnome.Ptyxis.metainfo.xml.in.in:128
msgid "The terminal will remind you when you're on a remote system"
msgstr "A terminál emlékeztetni fogja, ha távoli rendszeren van"

#: src/org.gnome.Ptyxis.gschema.xml.in:95
msgid "Default Profile UUID"
msgstr "Alapértelmezett profil UUID-ja"

#: src/org.gnome.Ptyxis.gschema.xml.in:96
msgid "The UUID of the default profile"
msgstr "Az alapértelmezett profil UUID-ja"

#: src/org.gnome.Ptyxis.gschema.xml.in:101
msgid "UUIDs of all Profiles"
msgstr "Az összes profil UUID-ja"

#: src/org.gnome.Ptyxis.gschema.xml.in:102
msgid "A list of UUID for every profile"
msgstr "Az UUID-k listája minden profilhoz"

#: src/org.gnome.Ptyxis.gschema.xml.in:107 src/ptyxis-preferences-window.ui:291
msgid "New Tab Position"
msgstr "Új lap helyzete"

#: src/org.gnome.Ptyxis.gschema.xml.in:108
msgid "Where to place new tabs"
msgstr "Hol legyenek elhelyezve az új lapok"

#: src/org.gnome.Ptyxis.gschema.xml.in:113 src/ptyxis-preferences-window.ui:383
msgid "Audible Bell"
msgstr "Hallható csengő"

#: src/org.gnome.Ptyxis.gschema.xml.in:114
msgid "If an audible bell should be used"
msgstr "Ha hallható csengőt kell használni"

#: src/org.gnome.Ptyxis.gschema.xml.in:119
msgid "Visible Bell"
msgstr "Látható csengő"

#: src/org.gnome.Ptyxis.gschema.xml.in:120
msgid "If a visual bell should be used"
msgstr "Ha látható csengőt kell használni"

#: src/org.gnome.Ptyxis.gschema.xml.in:125
msgid "Visual Process Leader"
msgstr "Látható folyamatvezető"

#: src/org.gnome.Ptyxis.gschema.xml.in:126
msgid ""
"Display a visual window highlight when process leader is SSH, sudo, or other "
"specialized tooling"
msgstr ""
"Látható ablakkijelölés megjelenítése, ha a folyamatvezető SSH, sudo vagy más s"
"peciális eszköz"

#: src/org.gnome.Ptyxis.gschema.xml.in:131
msgid "Use System Font"
msgstr "Rendszer betűkészletének használata"

#: src/org.gnome.Ptyxis.gschema.xml.in:132
msgid "If the default system monospace font should be used"
msgstr ""
"Ha a rendszer alapértelmezett, rögzített szélességű betűkészletét kell használ"
"ni"

#: src/org.gnome.Ptyxis.gschema.xml.in:137
msgid "Font Name"
msgstr "Betűkészlet neve"

#: src/org.gnome.Ptyxis.gschema.xml.in:138
msgid "The font description to use if use-system-font is set to False"
msgstr ""
"A használandó betűkészlet leírása, ha a „use-system-font” hamisra van állítva"

#: src/org.gnome.Ptyxis.gschema.xml.in:143 src/ptyxis-preferences-window.ui:218
msgid "Cursor Shape"
msgstr "Kurzor alakja"

#: src/org.gnome.Ptyxis.gschema.xml.in:144
msgid "The default shape of the cursor"
msgstr "A kurzor alapértelmezett alakja"

#: src/org.gnome.Ptyxis.gschema.xml.in:149
msgid "Cursor Blink Mode"
msgstr "Kurzor villogásának módja"

#: src/org.gnome.Ptyxis.gschema.xml.in:150
msgid "The default blink mode cursor"
msgstr "Az alapértelmezett villogási mód kurzor"

#: src/org.gnome.Ptyxis.gschema.xml.in:155
msgid "Scrollbar Policy"
msgstr "Görgetősáv irányelve"

#: src/org.gnome.Ptyxis.gschema.xml.in:156
msgid "If scrollbars should be displayed"
msgstr "Ha a görgetősávokat meg kell jeleníteni"

#: src/org.gnome.Ptyxis.gschema.xml.in:161
msgid "Text Blink Mode"
msgstr "Szöveg villogásának módja"

#: src/org.gnome.Ptyxis.gschema.xml.in:162
msgid "When text blinking is allowed"
msgstr "Ha a szöveg villogása engedélyezve van"

#: src/org.gnome.Ptyxis.gschema.xml.in:167
msgid "Interface Style"
msgstr "Felület stílusa"

#: src/org.gnome.Ptyxis.gschema.xml.in:168
msgid "If light or dark interface style should be used"
msgstr "Ha világos vagy sötét felületstílust kell használni"

#: src/org.gnome.Ptyxis.gschema.xml.in:173 src/ptyxis-preferences-window.ui:320
msgid "Restore Session"
msgstr "Munkamenet helyreállítása"

#: src/org.gnome.Ptyxis.gschema.xml.in:174
msgid "Restore tabs from previous session when starting Ptyxis"
msgstr "Lapok helyreállítása az előző munkamenetből a Ptyxis indításakor"

#: src/org.gnome.Ptyxis.gschema.xml.in:179 src/ptyxis-preferences-window.ui:326
msgid "Restore Window Size"
msgstr "Ablakméret helyreállítása"

#: src/org.gnome.Ptyxis.gschema.xml.in:180
msgid "Restore the previous window size when creating new windows"
msgstr "Az előző ablakméret helyreállítása új ablakok létrehozásakor"

#: src/org.gnome.Ptyxis.gschema.xml.in:190
msgid "Default Column Size"
msgstr "Alapértelmezett oszlopméret"

#: src/org.gnome.Ptyxis.gschema.xml.in:191
#: src/org.gnome.Ptyxis.gschema.xml.in:198
msgid "Default window size when restore-window-size is not true."
msgstr "Alapértelmezett ablakméret, ha a „restore-window-size” nem igaz."

#: src/org.gnome.Ptyxis.gschema.xml.in:197
msgid "Default Row Size"
msgstr "Alapértelmezett sorméret"

#: src/org.gnome.Ptyxis.gschema.xml.in:203
msgid "Toast on Copy Clipboard"
msgstr "Beúszó értesítés a vágólap másolásakor"

#: src/org.gnome.Ptyxis.gschema.xml.in:204
msgid "Show the user when text has copied to the clipboard."
msgstr "Megjelenítés a felhasználónak, ha szöveg lett másolva a vágólapra."

#: src/org.gnome.Ptyxis.gschema.xml.in:209
msgid "Enable Accessibility"
msgstr "Akadálymentesítés engedélyezése"

#: src/org.gnome.Ptyxis.gschema.xml.in:210
msgid ""
"Currently expirmental feature to send accessibility information to screen "
"readers."
msgstr ""
"Jelenleg kísérleti funkció, amely akadálymentesítési információkat küld a képe"
"rnyőolvasóknak."

#: src/org.gnome.Ptyxis.gschema.xml.in:219
msgid "Label"
msgstr "Címke"

#: src/org.gnome.Ptyxis.gschema.xml.in:220
msgid "The label for the profile"
msgstr "A profil címkéje"

#: src/org.gnome.Ptyxis.gschema.xml.in:225
msgid "Login Shell"
msgstr "Bejelentkezési parancsértelmező"

#: src/org.gnome.Ptyxis.gschema.xml.in:226
msgid "Use a login shell"
msgstr "Bejelentkezési parancsértelmező használata"

#: src/org.gnome.Ptyxis.gschema.xml.in:231 src/ptyxis-preferences-window.ui:451
#: src/ptyxis-profile-editor.ui:294
msgid "Limit Scrollback"
msgstr "Visszagörgetés korlátozása"

#: src/org.gnome.Ptyxis.gschema.xml.in:232
msgid "Limit the number of lines to keep for scrollback"
msgstr "A visszagörgetéshez megtartott sorok számának korlátozása"

#: src/org.gnome.Ptyxis.gschema.xml.in:238 src/ptyxis-preferences-window.ui:460
#: src/ptyxis-profile-editor.ui:303
msgid "Scrollback Lines"
msgstr "Visszagörgetési sorok"

#: src/org.gnome.Ptyxis.gschema.xml.in:239
msgid "The number of lines to keep in the scrollback, zero for no scrollback"
msgstr ""
"A visszagörgetéshez megtartott sorok száma, nulla esetén nincs visszagörgetés"

#: src/org.gnome.Ptyxis.gschema.xml.in:244 src/ptyxis-preferences-window.ui:441
#: src/ptyxis-profile-editor.ui:284
msgid "Scroll on Output"
msgstr "Görgetés kimenet esetén"

#: src/org.gnome.Ptyxis.gschema.xml.in:245
msgid "Scroll to the bottom upon new output"
msgstr "Görgetés alulra új kimenet írásakor"

#: src/org.gnome.Ptyxis.gschema.xml.in:250 src/ptyxis-preferences-window.ui:435
#: src/ptyxis-profile-editor.ui:278
msgid "Scroll on Keystroke"
msgstr "Görgetés billentyűleütéskor"

#: src/org.gnome.Ptyxis.gschema.xml.in:251
msgid "Scroll to the bottom upon user keystroke"
msgstr "Görgetés alulra felhasználói billentyűleütéskor"

#: src/org.gnome.Ptyxis.gschema.xml.in:256 src/ptyxis-profile-editor.ui:148
msgid "Use Custom Command"
msgstr "Egyéni parancs használata"

#: src/org.gnome.Ptyxis.gschema.xml.in:257
msgid "If a custom command should be used"
msgstr "Ha egyéni parancsot kell használni"

#: src/org.gnome.Ptyxis.gschema.xml.in:262
msgid "Use Proxy"
msgstr "Proxy használata"

#: src/org.gnome.Ptyxis.gschema.xml.in:263
msgid "Apply proxy settings from the host in the container"
msgstr "A géptől származó proxybeállítások alkalmazása a konténerben"

#: src/org.gnome.Ptyxis.gschema.xml.in:268 src/ptyxis-profile-editor.ui:153
msgid "Custom Command"
msgstr "Egyéni parancs"

#: src/org.gnome.Ptyxis.gschema.xml.in:269
msgid "A custom command for the shell"
msgstr "Egyéni parancs a parancsértelmezőhöz"

#: src/org.gnome.Ptyxis.gschema.xml.in:274 src/ptyxis-profile-editor.ui:172
msgid "Default Container"
msgstr "Alapértelmezett konténer"

#: src/org.gnome.Ptyxis.gschema.xml.in:275
msgid "The default container to run the command in"
msgstr "Az alapértelmezett konténer a parancs futtatásához"

#: src/org.gnome.Ptyxis.gschema.xml.in:280 src/ptyxis-profile-editor.ui:181
msgid "Preserve Container"
msgstr "Konténer megőrzése"

#: src/org.gnome.Ptyxis.gschema.xml.in:281
msgid "Preserve the active container when creating new tabs and windows"
msgstr "Az aktív konténer megőrzése új lapok vagy ablakok létrehozásakor"

#: src/org.gnome.Ptyxis.gschema.xml.in:286 src/ptyxis-preferences-window.ui:520
#: src/ptyxis-profile-editor.ui:242
msgid "Exit Action"
msgstr "Kilépési művelet"

#: src/org.gnome.Ptyxis.gschema.xml.in:287
msgid "The action to take when the shell exits"
msgstr "A parancsértelmező kilépésekor végrehajtandó művelet"

#: src/org.gnome.Ptyxis.gschema.xml.in:292
msgid "Preserve Directory"
msgstr "Könyvtár megőrzése"

#: src/org.gnome.Ptyxis.gschema.xml.in:293
msgid "If the directory should be preserved for new terminals"
msgstr "Ha a könyvtárat meg kell őrizni az új termináloknál"

#: src/org.gnome.Ptyxis.gschema.xml.in:298 src/ptyxis-inspector.ui:102
#: src/ptyxis-preferences-window.ui:40 src/ptyxis-profile-editor.ui:69
msgid "Palette"
msgstr "Paletta"

#: src/org.gnome.Ptyxis.gschema.xml.in:299
msgid "The color palette to use for the profile, by name"
msgstr "A profilhoz használandó színpaletta, név szerint"

#: src/org.gnome.Ptyxis.gschema.xml.in:305
msgid "Opacity"
msgstr "Átlátszatlanság"

#: src/org.gnome.Ptyxis.gschema.xml.in:306
msgid "The opacity of the palette background"
msgstr "A paletta hátterének átlátszatlansága"

#: src/org.gnome.Ptyxis.gschema.xml.in:311
msgid "Bold is Bright"
msgstr "A félkövér világos"

#: src/org.gnome.Ptyxis.gschema.xml.in:312
msgid ""
"Setting bold on one of the lower 8 colors in the palette will use bright "
"variant (upper 8 colors)"
msgstr ""
"A palettán lévő alsó 8 szín egyikének félkövérre állítása világos változatot f"
"og használni (felső 8 szín)"

#: src/org.gnome.Ptyxis.gschema.xml.in:317
msgid "CJK Ambiguous Width"
msgstr "CJK kétértelmű szélesség"

#: src/org.gnome.Ptyxis.gschema.xml.in:318
msgid "The size to apply to ambiguous width characters"
msgstr "Az alkalmazandó méret a kétértelmű szélességű karaktereknél"

#: src/org.gnome.Ptyxis.gschema.xml.in:323
#: src/org.gnome.Ptyxis.gschema.xml.in:329
msgid "Backspace Binding"
msgstr "Visszatörlés kötése"

#: src/org.gnome.Ptyxis.gschema.xml.in:324
#: src/org.gnome.Ptyxis.gschema.xml.in:330
msgid "What to send to the PTY when a backspace is entered"
msgstr "Mi legyen elküldve a PTY-nak egy visszatörlés billentyű megnyomásakor"

#: src/org.gnome.Ptyxis.gschema.xml.in:339 src/ptyxis-preferences-window.ui:613
msgid "Copy to Clipboard"
msgstr "Másolás a vágólapra"

#: src/org.gnome.Ptyxis.gschema.xml.in:340
msgid "The shortcut to copy to clipboard"
msgstr "A gyorsbillentyű a vágólapra másoláshoz"

#: src/org.gnome.Ptyxis.gschema.xml.in:345 src/ptyxis-preferences-window.ui:618
msgid "Paste from Clipboard"
msgstr "Beillesztés a vágólapról"

#: src/org.gnome.Ptyxis.gschema.xml.in:346
msgid "The shortcut to paste from the clipboard"
msgstr "A gyorsbillentyű a vágólapról való beillesztéshez"

#: src/org.gnome.Ptyxis.gschema.xml.in:352
msgid "The shortcut to create a new tab in the current window"
msgstr "A gyorsbillentyű új lap létrehozásához a jelenlegi ablakban"

#: src/org.gnome.Ptyxis.gschema.xml.in:358
msgid "The shortcut to create a new tab in a new window"
msgstr "A gyorsbillentyű új lap létrehozásához egy új ablakban"

#: src/org.gnome.Ptyxis.gschema.xml.in:363
msgid "Tab Overview"
msgstr "Lapáttekintés"

#: src/org.gnome.Ptyxis.gschema.xml.in:364
msgid "The shortcut to show the tab overview"
msgstr "A gyorsbillentyű a lapáttekintés megjelenítéséhez"

#: src/org.gnome.Ptyxis.gschema.xml.in:370
msgid "The shortcut to show application preferences"
msgstr "A gyorsbillentyű az alkalmazás beállításainak megjelenítéséhez"

#: src/org.gnome.Ptyxis.gschema.xml.in:375 src/ptyxis-preferences-window.ui:818
#: src/ptyxis-window.c:1245 src/ptyxis-window.c:1253
msgid "Zoom Out"
msgstr "Kicsinyítés"

#: src/org.gnome.Ptyxis.gschema.xml.in:376
msgid "The shortcut to zoom out"
msgstr "A gyorsbillentyű a kicsinyítéshez"

#: src/org.gnome.Ptyxis.gschema.xml.in:381 src/ptyxis-preferences-window.ui:823
#: src/ptyxis-window.c:1262
msgid "Reset Zoom"
msgstr "Nagyítás visszaállítása"

#: src/org.gnome.Ptyxis.gschema.xml.in:382
msgid "The shortcut to reset zoom"
