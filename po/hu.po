#: data/org.gnome.Ptyxis.desktop.in.in:2
msgid "@APP_NAME@"
msgstr "@APP_NAME@"

#: data/org.gnome.Ptyxis.desktop.in.in:3
msgid "A container-oriented terminal for GNOME"
msgstr "Egy konténerorientált terminál a GNOME-hoz"

#: data/org.gnome.Ptyxis.desktop.in.in:12 src/ptyxis-preferences-window.ui:610
#: src/ptyxis-tab.c:1229 src/ptyxis-util.c:308
msgid "Terminal"
msgstr "Terminál"

